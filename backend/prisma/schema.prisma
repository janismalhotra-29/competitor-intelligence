generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Competitor {
  id        String     @id @default(uuid())
  url       String     @unique
  createdAt DateTime   @default(now())
  snapshots Snapshot[]
  changes   Change[]
  alerts    Alert[]
  pricing   PricingPlan[]
}

model Snapshot {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  url          String
  pageTitle    String?
  extractedText String?
  metadata     String?
  capturedAt   DateTime   @default(now())
  status       String     @default("SUCCESS")
}

model Change {
  id              String     @id @default(uuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  oldSnapshotId   String?
  newSnapshotId   String
  hasChanges      Boolean    @default(false)
  diffSummary     String?
  detectedAt      DateTime   @default(now())
  aiSummary       AiSummary?
}

model AiSummary {
  id              String   @id @default(uuid())
  changeId        String   @unique
  change          Change   @relation(fields: [changeId], references: [id], onDelete: Cascade)
  analysis        String   // The human-readable text from the LLM
  significance    String   @default("UNKNOWN") // HIGH, MEDIUM, LOW, NONE, UNKNOWN
  createdAt       DateTime @default(now())
}

model Alert {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  changeId     String?
  title        String
  message      String
  significance String     @default("MEDIUM") // HIGH, MEDIUM, LOW
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model PricingPlan {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshotId   String?
  name         String     // e.g. "Free", "Starter", "Pro", "Enterprise"
  price        String     // e.g. "$0", "$29", "₹999", "Custom"
  period       String?    // "monthly", "yearly", "one-time"
  features     String?    // JSON string array of features
  updatedAt    DateTime   @default(now())
}

